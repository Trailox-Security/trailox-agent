<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>trailox-agent</AssemblyName>
    <RootNamespace>Trailox.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keep exception MESSAGES: with UseSystemResourceKeys the runtime logs resource keys such as
         net_http_client_execution_error instead of the text. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- Version is stamped by the release workflow (-p:Version=...); this is the dev default. -->
    <Version>0.1.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trailox.Agent.Tests" />
  </ItemGroup>

</Project>
