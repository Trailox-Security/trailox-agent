# MongoDB audit-log line templates, one per line as name|line.
#
# Provenance: real lines of an Atlas M10 audit file (MongoDB 8.0.34, Full audit, fetched through the
# Admin API), read only. Their spacing (" : ", ", ") and extended-JSON forms ({"$binary": ...,
# "$type": "04"}, {"$numberLong": ...}) are kept, because they decide the line size and the parser's work.
# Redacted before commit: every address is a documentation or private-range placeholder, and every
# UUID, base64 value and key id is filled in at generation time ({{...}}). The command in "args" is
# written by Commands.cs in the same form.
#
authCheck|{ "atype" : "authCheck", "ts" : { "$date" : "{{t}}" }, "uuid" : { "$binary" : "{{cuuid}}", "$type" : "04" }, "local" : { "ip" : "{{nip}}", "port" : 27017 }, "remote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "directRemote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "users" : [ { "user" : "{{user}}", "db" : "admin" } ], "roles" : [ { "role" : "readWrite", "db" : "{{db}}" } ], "param" : { "command" : "{{cmdname}}", "ns" : "{{ns}}", "args" : {{cmd}} }, "result" : {{result}} }
authenticate|{ "atype" : "authenticate", "ts" : { "$date" : "{{t}}" }, "uuid" : { "$binary" : "{{cuuid}}", "$type" : "04" }, "local" : { "ip" : "{{nip}}", "port" : 27017 }, "remote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "directRemote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "users" : [ { "user" : "{{user}}", "db" : "admin" } ], "roles" : [ { "role" : "readWrite", "db" : "{{db}}" } ], "param" : { "user" : "{{user}}", "db" : "admin", "mechanism" : "SCRAM-SHA-256" }, "result" : {{result}} }
clientMetadata|{ "atype" : "clientMetadata", "ts" : { "$date" : "{{t}}" }, "uuid" : { "$binary" : "{{cuuid}}", "$type" : "04" }, "local" : { "ip" : "{{nip}}", "port" : 27017 }, "remote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "directRemote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "users" : [], "roles" : [], "param" : { "localEndpoint" : { "ip" : "{{nip}}", "port" : 27017 }, "clientMetadata" : { "application" : { "name" : "{{app}}" }, "driver" : { "name" : "{{drv}}", "version" : "{{drvver}}" }, "os" : { "type" : "linux", "architecture" : "x86_64" }, "platform" : "CPython 3.12.9.final.0" } }, "result" : 0 }
createIndex|{ "atype" : "createIndex", "ts" : { "$date" : "{{t}}" }, "uuid" : { "$binary" : "{{cuuid}}", "$type" : "04" }, "local" : { "ip" : "{{nip}}", "port" : 27017 }, "remote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "directRemote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "users" : [ { "user" : "{{user}}", "db" : "admin" } ], "roles" : [ { "role" : "readWrite", "db" : "{{db}}" } ], "param" : { "ns" : "{{ns}}", "indexName" : "customer_1", "indexSpec" : { "v" : 2, "key" : { "customer" : 1 }, "name" : "customer_1" } }, "result" : 0 }
noise|{ "atype" : "logout", "ts" : { "$date" : "{{t}}" }, "uuid" : { "$binary" : "{{cuuid}}", "$type" : "04" }, "local" : { "ip" : "{{nip}}", "port" : 27017 }, "remote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "directRemote" : { "ip" : "{{cip}}", "port" : {{cport}} }, "users" : [], "roles" : [], "param" : { "reason" : "Client has disconnected", "initialUsers" : [ { "user" : "{{user}}", "db" : "admin" } ], "updatedUsers" : [], "loginTime" : { "$date" : "{{t}}" } }, "result" : 0 }
