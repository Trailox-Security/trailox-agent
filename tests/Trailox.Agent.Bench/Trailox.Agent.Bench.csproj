<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MongoDB throughput gate (D12): a console program, not a test project and not shipped.
       It generates gzip mongod/audit log files from real line templates and measures a prototype of
       the MongoDB engine's streaming pipeline. Runtime settings match the agent's own csproj, so a run
       inside the agent image at the chart's limits measures what the agent would do. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>trailox-agent-bench</AssemblyName>
    <RootNamespace>Trailox.Agent.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\*.tmpl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
