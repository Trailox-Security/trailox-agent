<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MongoDB throughput gate (D12): a console program, not a test project and not shipped.
       It generates gzip mongod/audit log files from real line templates (and their S3-export form) and
       reads them through the agent's own MongoDB engine classes. Runtime settings match the agent's own
       csproj, so a run at the chart's limits measures what the agent would do. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>trailox-agent-bench</AssemblyName>
    <RootNamespace>Trailox.Agent.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Trailox.Agent\Trailox.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\*.tmpl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
